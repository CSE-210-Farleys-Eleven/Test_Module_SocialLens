{
  "name": "sociallens-mini-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Proof-of-concept SocialLens: browser-only, self-only analytics and privacy observations over your own public AT Protocol records.",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@atproto/oauth-client-browser": "^0.5.15"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
